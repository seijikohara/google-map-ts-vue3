{
  "name": "google-map-ts-vue3",
  "version": "2.0.0",
  "description": "Google Map Vue3 Component",
  "keywords": [
    "google",
    "maps",
    "typescript",
    "vue3"
  ],
  "homepage": "https://github.com/seijikohara/google-map-ts-vue3#readme",
  "bugs": {
    "url": "https://github.com/seijikohara/google-map-ts-vue3/issues"
  },
  "license": "MIT",
  "author": "Seiji Kohara <sage.0118@gmail.com> (https://github.com/seijikohara)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seijikohara/google-map-ts-vue3.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/google-map-ts-vue3.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/google-map-ts-vue3.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "lefthook install || exit 0",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --project=chromium",
    "test:watch": "vitest --project=chromium",
    "check:package": "node scripts/check-package.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@types/google.maps": "^3.58.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.58.9",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "^5.0.5",
    "@vue/language-core": "^3.3.7",
    "@vue/tsconfig": "0.9.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.61.1",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.1.4",
    "vitest": "^5.0.5",
    "vitest-browser-vue": "^3.1.0",
    "vue": "^3.5.39",
    "vue-tsc": "3.3.13"
  },
  "peerDependencies": {
    "vue": ">=3.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@12.14.0"
}
